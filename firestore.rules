rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdminInmobiliaria() {
      return request.auth != null &&
        (currentUser().role == 'admin' || currentUser().rol == 'ADMIN');
    }

    function isSuperadmin() {
      return request.auth != null &&
        (currentUser().role == 'superadmin' || currentUser().rol == 'SUPERADMIN');
    }

    // === Usuarios ===
    match /users/{userId} {
      allow read: if request.auth != null;

      // Cada usuario puede escribir su propio perfil
      allow write: if request.auth != null && request.auth.uid == userId;

      // Admin inmobiliaria puede crear asesores pendientes
      allow create: if isAdminInmobiliaria() &&
        request.resource.data.role == 'asesor' &&
        request.resource.data.rol == 'ASESOR' &&
        request.resource.data.activo == false &&
        request.resource.data.habilitado == false;

      // Superadmin puede habilitar/aprobar usuarios
      allow update: if isSuperadmin();

      allow delete: if false;
    }

    match /usuarios/{userId} {
      allow read: if request.auth != null;

      // Admin inmobiliaria puede crear el espejo del asesor pendiente
      allow create: if isAdminInmobiliaria() &&
        request.resource.data.rol == 'ASESOR' &&
        request.resource.data.activo == false;

      // Superadmin puede actualizar/habilitar si su pantalla usa esta colección
      allow update: if isSuperadmin();

      allow delete: if false;
    }

    // === OTPs ===
    // OTPs de registro: acceso sin auth porque el usuario aún no tiene cuenta
    match /emailOtps/{email} {
      allow read, write: if true;
    }

    // === Proyectos ===
    match /proyectos/{proyectoId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // === Comentarios ===
    match /comentarios/{comentarioId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null &&
                              request.auth.uid == resource.data.idUsuario;
    }

    // === Approvals ===
    match /approvals/{approvalId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // === Notifications ===
    match /notifications/{notifId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // === Logs ===
    match /logs/{logId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
    }

    // === Metadata interna de la app (contador de logs, etc.) ===
    match /app_meta/{docId} {
      allow read, write: if request.auth != null;
    }

    // === CHATS (corregido para permitir verificar antes de crear) ===
    match /chats/{chatId} {
      allow create: if request.auth != null &&
                      request.auth.uid in request.resource.data.participantes;

      // CLAVE: permite leer cuando el doc aun no existe (para verificar antes de crear)
      allow read: if request.auth != null &&
                    (resource == null || request.auth.uid in resource.data.participantes);

      allow update: if request.auth != null &&
                      request.auth.uid in resource.data.participantes;

      allow delete: if false;

      match /mensajes/{mensajeId} {
        allow read: if request.auth != null &&
                      request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantes;

        allow create: if request.auth != null &&
                        request.auth.uid == request.resource.data.idEmisor &&
                        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantes;

        allow update: if request.auth != null &&
                        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantes;

        allow delete: if false;
      }
    }

    // === Separaciones ===
    match /separaciones/{id} {
      allow read, write: if request.auth != null;
    }

    // === Valoraciones ===
    match /valoraciones/{id} {
      allow read, write: if request.auth != null;
    }

    // === Citas ===
    // TODO (PC-04): restringir con reglas específicas antes de producción — ver PENDING_COORDINATION.md
    match /citas/{id} {
      allow read, write: if request.auth != null;
    }

    // === Slots de disponibilidad ===
    // Creado por: auditoría Cliente (Pedro/Branch-1) — 2026-07-13
    match /slots/{slotId} {
      allow read, write: if request.auth != null;
    }
  }
}
